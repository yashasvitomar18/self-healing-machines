# Predictive Maintenance Dashboard — environment variables
#
# Copy this file to ".env.local" (which is git-ignored) and edit values as
# needed. Vite exposes any var prefixed with VITE_ to the browser.

# Base URL of the Python FastAPI backend, WITHOUT a trailing slash.
# Example: http://localhost:8000
# Leave empty/unset to stay in mock mode for UI development.
VITE_API_BASE_URL=

# Force mock data on/off. Defaults to "true" when no API base URL is set.
# Set to "false" once the FastAPI backend is running and reachable.
VITE_USE_MOCK=true
